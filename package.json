{
  "name": "@jaetask/open-agent-kit",
  "version": "0.2.1",
  "description": "A small kit for standalone apps that each carry their own agent and join together over MCP.",
  "keywords": [
    "agent",
    "mcp",
    "actions",
    "pi-durable",
    "ddd"
  ],
  "author": "jaetask",
  "license": "MIT",
  "homepage": "https://github.com/jaetask/open-agent-kit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jaetask/open-agent-kit.git"
  },
  "bugs": "https://github.com/jaetask/open-agent-kit/issues",
  "files": [
    "dist",
    "README.md",
    "GLOSSARY.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./sqlite": {
      "types": "./dist/sqlite.d.ts",
      "import": "./dist/sqlite.js"
    },
    "./pi": {
      "types": "./dist/pi/index.d.ts",
      "import": "./dist/pi/index.js"
    },
    "./mcp": {
      "types": "./dist/mcp/index.d.ts",
      "import": "./dist/mcp/index.js"
    },
    "./app": {
      "types": "./dist/app/index.d.ts",
      "import": "./dist/app/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit && tsc -p examples/notes/page",
    "test": "tsx --test src/*.test.ts",
    "expect": "tsx expect/snap.ts",
    "lint": "biome lint . && npm run check:docs && npm run example:guard",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "prepare": "git config core.hooksPath .agents/guardrails/hooks || true",
    "check:docs": "node scripts/check-docs.mjs",
    "example": "node examples/notes/build.mjs && tsx examples/notes/app.ts",
    "example:build": "node examples/notes/build.mjs",
    "example:guard": "toolkit-guard examples/notes/page",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "prepublishOnly": "npm run typecheck && npm run lint && npm run format:check && npm run test && npm run expect && npm run build"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.5",
    "@earendil-works/chord": "1.5.2",
    "@earendil-works/pi-ai": "1.5.2",
    "@earendil-works/pi-durable": "1.5.2",
    "@fontsource-variable/inter": "^5.2.8",
    "@jaetask/snap": "0.1.0",
    "@jaetask/toolkit": "0.3.1",
    "@modelcontextprotocol/client": "2.4.0",
    "@modelcontextprotocol/server": "2.4.0",
    "@tailwindcss/cli": "4.3.5",
    "@types/node": "22.18.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "4.3.5",
    "tsx": "4.20.5",
    "typescript": "5.9.2"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "peerDependencies": {
    "@earendil-works/chord": "1.5.2",
    "@earendil-works/pi-ai": "1.5.2",
    "@earendil-works/pi-durable": "1.5.2",
    "@modelcontextprotocol/client": "2.4.0",
    "@modelcontextprotocol/server": "2.4.0"
  },
  "peerDependenciesMeta": {
    "@earendil-works/chord": {
      "optional": true
    },
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-durable": {
      "optional": true
    },
    "@modelcontextprotocol/client": {
      "optional": true
    },
    "@modelcontextprotocol/server": {
      "optional": true
    }
  }
}
