{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": { "includes": ["**", "!docs", "!.claude", "!**/*.expect.md"] },
  "formatter": { "indentStyle": "space", "lineWidth": 100 },
  "linter": {
    "rules": {
      "style": {
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "patterns": [
              {
                "group": ["@earendil-works/*", "@earendil-works/*/**"],
                "message": "Only the /pi entry point (src/pi) may import pi-durable and its packages."
              },
              {
                "group": ["@modelcontextprotocol/*", "@modelcontextprotocol/*/**"],
                "message": "Only the /mcp entry point (src/mcp) may import the MCP SDK."
              }
            ]
          }
        }
      }
    }
  },
  "overrides": [
    {
      "includes": ["src/pi/**", "src/mcp/**", "expect/pi*.ts", "expect/mcp*.ts", "expect/apps.ts"],
      "linter": { "rules": { "style": { "noRestrictedImports": "off" } } }
    }
  ]
}
